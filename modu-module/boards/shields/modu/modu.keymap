#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define MAC   1
#define LOWER 2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------
// |ESC | 1  | 2  | 3  | 4  | 5  |   | 6  | 7  | 8  | 9  | 0  |BSPC|
// |TAB | Q  | W  | E  | R  | T  |   | Y  | U  | I  | O  | P  | \  |
// |CAPS| A  | S  | D  | F  | G  |   | H  | J  | K  | L  | ;  |RET |
// |LSFT| Z  | X  | C  | V  | B  |   | N  | M  | ,  | .  | /  |RSFT|
// |LCTL|LALT|LGUI|                            |RALT|RCTL|DEL |
//            |MO  |SPC |RET |   |BSPC|SPC |MO  |////|
//
// Hangul toggle is RALT on Windows and CAPS on macOS, matching what each
// platform already uses. `\` doubles as the Won sign under a Hangul IME.
//
// The outermost key of the right thumb group (////) has no switch fitted -
// the module takes up that end of the cluster - so it is left as &none.
            bindings = <
&kp ESC   &kp N1   &kp N2    &kp N3    &kp N4    &kp N5      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0     &kp BSPC
&kp TAB   &kp Q    &kp W     &kp E     &kp R     &kp T       &kp Y     &kp U     &kp I     &kp O     &kp P      &kp BSLH
&kp CAPS  &kp A    &kp S     &kp D     &kp F     &kp G       &kp H     &kp J     &kp K     &kp L     &kp SEMI   &kp RET
&kp LSHFT &kp Z    &kp X     &kp C     &kp V     &kp B       &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH   &kp RSHFT
&kp LCTRL &kp LALT &kp LGUI  &none     &none     &none       &none     &none     &none     &kp RALT  &kp RCTRL  &kp DEL
                             &mo LOWER &kp SPACE &kp RET     &kp BSPC  &kp SPACE &mo LOWER &none
            >;
        };

        /*
         * macOS overlay - toggled on/off with `LOWER + V`.
         *
         * Sits below LOWER on purpose: every position that is not OS specific
         * stays &trans so the LOWER layer keeps working unchanged on top of it.
         * Only add keys here that must differ between Windows and macOS.
         *
         * Right-hand mods: RALT/RCTRL -> RGUI/RALT, so the key beside the
         * space bar is Command and the one outside it is Option, mirroring
         * Ctrl/Option/Command on the left half.
         */
        mac_layer {
            bindings = <
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans     &trans
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans     &trans
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans     &trans
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans     &trans
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &kp RGUI  &kp RALT   &trans
                             &trans    &trans    &trans      &trans    &trans    &trans    &trans
            >;
        };

        lower_layer {
// -----------------------------------------------------------------------
// | F1 | F2 | F3 | F4 | F5 | F6 |   | F7 | F8 | F9 |F10 |F11 |F12 |
// |BTCL|BT0 |BT1 |BT2 |    |    |   |MCLK|    |    | `  | [  | ]  |
// |    |    |    |    |    |    |   |RCLK|    |    | -  | =  | '  |
// |    | UP |    |    |MAC |    |   |LCLK|    |    |    | UP |    |
// |LEFT|DOWN|RGHT|                            |LEFT|DOWN|RGHT|
//
// Arrows form a proper cross on both halves: UP sits directly above DOWN.
            bindings = <
&kp F1     &kp F2       &kp F3       &kp F4       &kp F5    &kp F6      &kp F7    &kp F8    &kp F9    &kp F10    &kp F11    &kp F12
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans    &trans      &mkp MCLK &trans    &trans    &kp GRAVE  &kp LBKT   &kp RBKT
&trans     &trans       &trans       &trans       &trans    &trans      &mkp RCLK &trans    &trans    &kp MINUS  &kp EQUAL  &kp SQT
&trans     &kp UP       &trans       &trans       &tog MAC  &trans      &mkp LCLK &trans    &trans    &trans     &kp UP     &trans
&kp LEFT   &kp DOWN     &kp RIGHT    &trans       &trans    &trans      &trans    &trans    &trans    &kp LEFT   &kp DOWN   &kp RIGHT
                                     &trans       &trans    &trans      &trans    &trans    &trans    &trans
            >;
        };
    };
};
