#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define MAC   1
#define LOWER 2

/*
 * Names for the pointing behaviours, which ZMK ships without.
 *
 * ⚠️ Every other behaviour carries a display-name and these two do not, so a
 * Studio client lists them by their devicetree node names - "mouse_move",
 * "mouse_scroll" - in the same menu as "Key Press" and "Momentary Layer".
 *
 * Set here rather than patched into ZMK: it is a devicetree property, and a
 * property can be overridden from the shield.
 */
&mmv {
    display-name = "Mouse Move";
};

&msc {
    display-name = "Mouse Scroll";
};

/ {
    combos {
        compatible = "zmk,combos";

        /*
         * Hold either MO, then press the physical 5, 6 and J keys.
         *
         * Ported from upstream (22sh22 7ac3379), with two changes forced by
         * how this fork's layers differ:
         *
         * - Layer 1 -> LOWER (2). Upstream's function layer is 1; here 1 is
         *   mac_layer. ZMK matches combos against the *highest* active layer
         *   (combo_active_on_layer in app/src/combo.c), so layer 1 would only
         *   arm this while the macOS overlay is on top and MO is not held.
         *
         * - Position 48 -> 31. A combo swallows its keys until it resolves, so
         *   whatever sits at those positions on this layer goes mute: a tap
         *   only lands on release, and a held key waits out timeout-ms. On
         *   upstream's layer 48 is &trans, but this fork moved the arrow
         *   cluster down a row and 48 is the left-hand LEFT arrow - holding it
         *   to walk the cursor would stall for half a second. Position 31 is
         *   the `J` slot, &trans here: nobody types a letter while holding MO.
         *   Note it must stay off 33 (`L`), which carries `-`.
         *
         * Nothing changes on the base layer - without MO held the combo is
         * never even a candidate.
         */
        system_reset_combo {
            timeout-ms = <500>;
            key-positions = <5 6 31>;
            bindings = <&sys_reset>;
            layers = <LOWER>;
        };

        /*
         * Hold either MO, then press the physical 5, 6 and F keys to reboot
         * into the UF2 bootloader - the same state the reset button reaches
         * when tapped twice, so MODU_BOOT appears and a .uf2 can be copied.
         *
         * Shares the 5/6 anchors with system_reset_combo and splits on the
         * third key: reset takes the right hand (31, `J`), this takes the
         * left (28, `F`). Both are &trans on this layer, so neither combo
         * mutes a key that does something here. Keeping them a hand apart
         * is deliberate - the two outcomes are not interchangeable and a
         * misroll should not reach the other one.
         *
         * A plain key was the alternative and is worse: one stray press and
         * the keyboard sits in DFU and stops typing.
         *
         * ⚠️ This reboots the LEFT half only, whichever half the keys are on.
         * &bootloader is BEHAVIOR_LOCALITY_EVENT_SOURCE, but combo.c hardcodes
         * the binding event's source to ZMK_POSITION_STATE_CHANGE_SOURCE_LOCAL
         * and that path invokes locally (app/src/behavior.c) - a combo has no
         * one key position to attribute, so there is no peripheral to send it
         * to. The right half is still flashed via its own reset button.
         *
         * ⚠️ This is convenience, not a rescue path. It only works while the
         * keymap still has this layer and these positions - exactly what is
         * missing when a bad keymap is the problem. The reset button stays
         * the way out of that; see KEYMAP.md.
         */
        bootloader_combo {
            timeout-ms = <500>;
            key-positions = <5 6 28>;
            bindings = <&bootloader>;
            layers = <LOWER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// -----------------------------------------------------------------------
// |ESC | 1  | 2  | 3  | 4  | 5  |   | 6  | 7  | 8  | 9  | 0  |BSPC|
// |TAB | Q  | W  | E  | R  | T  |   | Y  | U  | I  | O  | P  | \  |
// |CAPS| A  | S  | D  | F  | G  |   | H  | J  | K  | L  | ;  |RET |
// |LSFT| Z  | X  | C  | V  | B  |   | N  | M  | ,  | .  | /  |RSFT|
// |LCTL|LALT|LGUI|                            |RALT|RCTL|DEL |
//            |MO  |SPC |RET |   |BSPC|SPC |MO  |////|
//
// Hangul toggle is RALT on Windows and CAPS on macOS, matching what each
// platform already uses. `\` doubles as the Won sign under a Hangul IME.
//
// The outermost key of the right thumb group (////) has no switch fitted -
// the module takes up that end of the cluster - so it is left as &none.
            bindings = <
&kp ESC   &kp N1   &kp N2    &kp N3    &kp N4    &kp N5      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0     &kp BSPC
&kp TAB   &kp Q    &kp W     &kp E     &kp R     &kp T       &kp Y     &kp U     &kp I     &kp O     &kp P      &kp BSLH
&kp CAPS  &kp A    &kp S     &kp D     &kp F     &kp G       &kp H     &kp J     &kp K     &kp L     &kp SEMI   &kp RET
&kp LSHFT &kp Z    &kp X     &kp C     &kp V     &kp B       &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH   &kp RSHFT
&kp LCTRL &kp LALT &kp LGUI  &none     &none     &none       &none     &none     &none     &kp RALT  &kp RCTRL  &kp DEL
                             &mo LOWER &kp SPACE &kp RET     &kp BSPC  &kp SPACE &mo LOWER &none
            >;
        };

        /*
         * macOS overlay - toggled on/off with `LOWER + V`.
         *
         * Sits below LOWER on purpose: every position that is not OS specific
         * stays &trans so the LOWER layer keeps working unchanged on top of it.
         * Only add keys here that must differ between Windows and macOS.
         *
         * Right-hand mods: RALT/RCTRL -> RGUI/RALT, so the key beside the
         * space bar is Command and the one outside it is Option, mirroring
         * Ctrl/Option/Command on the left half.
         */
        mac_layer {
            display-name = "Mac";
            bindings = <
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans     &trans
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans     &trans
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans     &trans
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans     &trans
&trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans    &kp RGUI  &kp RALT   &trans
                             &trans    &trans    &trans      &trans    &trans    &trans    &trans
            >;
        };

        lower_layer {
            display-name = "Fn";
// -----------------------------------------------------------------------
// | F1 | F2 | F3 | F4 | F5 | F6 |   | F7 | F8 | F9 |F10 |F11 |F12 |
// |BTCL|BT0 |BT1 |BT2 |STUD|    |   |MCLK|    |    | `  | [  | ]  |
// |    |    |    |    |    |    |   |RCLK|    |    | -  | =  | '  |
// |    | UP |    |    |MAC |    |   |LCLK|    |    |    | UP |    |
// |LEFT|DOWN|RGHT|                            |LEFT|DOWN|RGHT|
//
// Arrows form a proper cross on both halves: UP sits directly above DOWN.

//
// STUD is `&studio_unlock`. ZMK Studio locks the keyboard against edits by
// default and this is the only way to grant it - without a key bound to it
// Studio connects but every change is refused. Placed beside the BT keys
// because it belongs to the same "manage the device" group; move it freely.
            bindings = <
&kp F1     &kp F2       &kp F3       &kp F4       &kp F5    &kp F6      &kp F7    &kp F8    &kp F9    &kp F10    &kp F11    &kp F12
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &studio_unlock &trans   &mkp MCLK &trans    &trans    &kp GRAVE  &kp LBKT   &kp RBKT
&trans     &trans       &trans       &trans       &trans    &trans      &mkp RCLK &trans    &trans    &kp MINUS  &kp EQUAL  &kp SQT
&trans     &kp UP       &trans       &trans       &tog MAC  &trans      &mkp LCLK &trans    &trans    &trans     &kp UP     &trans
&kp LEFT   &kp DOWN     &kp RIGHT    &trans       &trans    &trans      &trans    &trans    &trans    &kp LEFT   &kp DOWN   &kp RIGHT
                                     &trans       &trans    &trans      &trans    &trans    &trans    &trans
            >;
        };
    };
};
